prefix: "set -euo pipefail; "
data_dir: "data"
progress_dir: ".progress"
error_probs_path: "data/external/EmpiricalErrorPlatinum1000G.csv"

tsinfer:
  - version: "0.5.1"
    path: "~/bin/tsinfer_0_5_1"
  - version: "0.4.1"
    path: "~/bin/tsinfer_0_4_1"

sims:
  - model: "OutOfAfrica_4J17"
    contig: "chr20"
    left: 0
    right: 1e7
    samples: {"CEU": 100, "CHB": 100, "YRI": 100}
    num_reps: 1
    seed: 1

error_configs:
  - geno_multiplier: 0.0
    phase_ser: 0.0
    mispol_rate: 0.0
    name: "none"

ancestor_chunk_size: 5000

resources:
  default:
    threads: 1
    mem_mb: 8000
    time_min: 500

  simulate:
    threads: 15
    mem_mb: 64000
    time_min: 500

  bio2zarr_convert:
    threads: 15
    mem_mb: 64000
    time_min: 500

  process_ancestor_chunk:
    threads: 1
    mem_mb: 16000
    time_min: 500
