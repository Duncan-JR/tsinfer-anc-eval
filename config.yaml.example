prefix: "set -euo pipefail; "
data_dir: "data/anc_eval"
progress_dir: "data/anc_eval/progress"
env_dir: "/well/kelleher/users/uuc395/tsinfer-paper/env"
tsinfer_dir: "/well/kelleher/users/uuc395/tsinfer"
error_probs_path: "data/external/EmpiricalErrorPlatinum1000G.csv"

sims:
  - model: "OutOfAfrica_4J17"
    contig: "chr20"
    left: 2e6
    right: 4e6
    samples: {"CEU": 100, "CHB": 100, "YRI": 100}
    num_reps: 1
    seed: 2

error_configs:
  - empgeno: "off"
    phase: 5e-3
    mispol: 1e-2
    name: "none"

versions:
  - 0.4
  - 1.0

ancestor_chunk_size: 5000

resources:
  default:
    threads: 32 
    mem_mb: 64000
    time_min: 500

  simulate:
    threads: 192 
    mem_mb: 1000000
    time_min: 500

  bio2zarr_convert:
    threads: 192 
    mem_mb: 1000000
    time_min: 500

  process_ancestor_chunk:
    threads: 1
    mem_mb: 96000
    time_min: 500
